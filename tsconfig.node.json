{
  // Code that runs in Node: the Vite and Vitest configs, and the unit tests (Vitest brings Node's types,
  // which the app's own files must not see). DOM: the store and sync modules the tests load name page
  // types such as Response.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "src/**/*.test.ts", "tests/e2e", "worker"]
}
